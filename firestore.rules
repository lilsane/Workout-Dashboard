rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Single health-profile doc per user, keyed by uid. Holds personal
    // details, body measurements, medical conditions, and fitness info.
    match /healthProfile/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Workout log docs are owned via their userId field. Queries must filter
    // on userId == auth.uid to satisfy the read rule; updates can never
    // reassign ownership.
    match /workouts/{workoutId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Single scratch-note doc per user, keyed by uid.
    match /notes/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Single dashboard-settings doc per user, keyed by uid.
    match /settings/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
